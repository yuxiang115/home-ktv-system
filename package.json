{
  "name": "home-ktv-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:local": "bash scripts/dev/dev-local.sh",
    "db:migrate": "pnpm -F @home-ktv/api migrate",
    "seed:demo-song": "node scripts/tools/seed-demo-song.mjs",
    "ui:visual-check": "node scripts/tools/ui-visual-check.mjs",
    "ui:visual-check:test": "node --test scripts/tools/ui-visual-check.test.mjs",
    "tv:visual-check": "node scripts/tools/tv-visual-check.mjs",
    "real-mv:risk-spike": "node scripts/tools/real-mv-playback-risk-spike.mjs",
    "ktv:probe": "pnpm -F @home-ktv/api probe:ktv-index",
    "ktv:tags": "pnpm -F @home-ktv/api tag:ktv-styles",
    "deploy:doctor": "node scripts/tools/deploy-doctor.mjs",
    "repo:hygiene": "node scripts/tools/repo-hygiene-check.mjs",
    "deploy:docker": "bash deploy/docker/ktv.sh",
    "deploy:source": "bash deploy/source/ktv.sh",
    "deploy:smoke": "node scripts/tools/web-deploy-smoke.mjs",
    "hot-songs:sources": "pnpm -F @home-ktv/hot-songs collect-sources",
    "hot-songs:normalize": "pnpm -F @home-ktv/hot-songs normalize",
    "hot-songs:fuse": "pnpm -F @home-ktv/hot-songs fuse",
    "hot-songs:update": "pnpm -F @home-ktv/hot-songs run update",
    "hot-songs:sources:test": "pnpm -F @home-ktv/hot-songs test",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "2.9.6",
    "typescript": "6.0.3"
  }
}
