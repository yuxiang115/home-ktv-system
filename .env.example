DATABASE_URL=
CONTROLLER_BASE_URL=
MEDIA_ROOT=
PUBLIC_BASE_URL=
CORS_ALLOWED_ORIGINS=
TV_ROOM_SLUG=living-room

# Online supplement (search YouTube/Bilibili -> build a spec-named NAS MV -> index).
# Off by default; flipping to true enables the online search section and the API-side
# LISTEN/NOTIFY progress channel. The worker runs as a separate process.
ONLINE_SUPPLEMENT_ENABLED=false
# youtube-basic: download -> LLM rename -> lyrics -> index (original vocal only)
# youtube-enhanced: also Demucs accompaniment + dual-track mix (original/instrumental switch)
ONLINE_SUPPLEMENT_WORKFLOW=youtube-basic
SUPPLEMENT_IMPORT_ROOT=/mnt/nas/KTV歌曲/_online
SUPPLEMENT_BATCH_SIZE=4
SUPPLEMENT_BATCH_TIMEOUT_SEC=30
# Synced lyrics (.lrc) source; best-effort, failures never block the pipeline.
LYRICS_LRCLIB_BASE_URL=https://lrclib.net
# Worker process: pnpm -F @home-ktv/api supplement:worker
SUPPLEMENT_POLL_INTERVAL_MS=5000
SUPPLEMENT_LEASE_DURATION_MS=300000
SUPPLEMENT_WORKER_ID=
SUPPLEMENT_DRY_RUN=false
# YouTube download of copyrighted MVs often returns 403 without a cookie.
# Export your logged-in YouTube cookie (browser devtools -> Network -> Cookie header,
# or use yt-dlp --cookies-from-browser) and paste the full Cookie string here.
YOUTUBE_COOKIE=
YT_DLP_BIN=yt-dlp
# Windows 下必须是真实二进制(python.exe),配合 ARGS=-m yt_dlp;.bat shim 无法被 execFile 执行
YT_DLP_ARGS=
# YouTube player client(默认 android:web/android vr 客户端对版权 MV 常返回 403)
YOUTUBE_PLAYER_CLIENT=android
# Demucs (vocal removal) + ffmpeg (dual-track mix) used by the youtube-enhanced workflow.
# DEMUCS_DEVICE: cuda when torch is the CUDA build + NVIDIA GPU present (RTX 3070 ~12x realtime), else cpu.
DEMUCS_BIN=demucs
DEMUCS_ARGS=
DEMUCS_DEVICE=cuda
DEMUCS_MODEL=htdemucs
FFMPEG_BIN=ffmpeg
