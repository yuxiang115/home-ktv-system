FROM node:22-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable \
  && apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates python3 postgresql-client \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN pnpm install --frozen-lockfile \
  && pnpm -F @home-ktv/api... build

EXPOSE 4000

CMD ["sh", "-lc", "pnpm -F @home-ktv/api migrate && node apps/api/dist/server.js"]
